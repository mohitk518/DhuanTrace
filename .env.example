# Copy this file to .env for local runs, or pass these as Cloud Run environment variables.
# Every key is optional: a missing or failing source falls back to clearly labelled sample data.

# NASA FIRMS fire data. Free key: https://firms.modaps.eosdis.nasa.gov/api/map_key/
FIRMS_MAP_KEY=

# CPCB real-time AQI through data.gov.in. Free key: sign in at https://data.gov.in, open My Account, copy the API key
DATA_GOV_API_KEY=

# Google Gemini. Free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional: model id (default gemini-3.7-flash, falls back to gemini-3.5-flash and gemini-3.8-flash)
GEMINI_MODEL=gemini-3.7-flash

# Region pack from regions/: mp (Madhya Pradesh, default) or punjab-haryana. See SCALING.md
REGION=mp

# 1 = force sample data for every source (safe mode for a demo on bad venue Wi-Fi)
DEMO_MODE=0

# 0 = hide the example citizen reports and show only real ones
EXAMPLE_REPORTS=1

# Optional backup for station AQI when data.gov.in is down: free token from https://aqicn.org/data-platform/token
WAQI_TOKEN=

# Cloud Run only (DEPLOY_CLOUD_RUN.bat sets these): Cloud Storage bucket for saved data, and the secret token
# Cloud Scheduler sends to POST /api/jobs/hourly. Leave empty on a laptop.
GCS_BUCKET=
JOB_TOKEN=
